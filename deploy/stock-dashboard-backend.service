[Unit]
Description=Stock Dashboard - Backend (FastAPI/yfinance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__/backend
ExecStart=__APP_DIR__/backend/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# Falls kein venv erstellt wurde: erst `python3 -m venv backend/.venv` + pip install

[Install]
WantedBy=multi-user.target