# Kopieren nach .env.local (wird nicht eingecheckt) und ausfüllen.
# Supabase-Dashboard → Project Settings → API Keys / Data API
VITE_SUPABASE_URL=https://DEINPROJEKT.supabase.co
# "Publishable key" (sb_publishable_…) bzw. bei älteren Projekten der "anon"-Key – darf öffentlich sein
VITE_SUPABASE_ANON_KEY=
